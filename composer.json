{
    "name": "jerry-ai-2026/db-tools",
    "description": "Laravel 数据库导入/导出工具命令集：JSON/CSV/Excel 导入，JSON/迁移/种子导出，连接信息查看。",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jerry",
            "email": "ajl@ajl.biz"
        }
    ],
    "support": {
        "source": "https://github.com/jerry-ai-2026/db-tools.git",
        "issues": "https://github.com/jerry-ai-2026/db-tools/issues"
    },
    "require": {
        "php": "^8.1",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "phpoffice/phpspreadsheet": "^3.0 || ^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Jerry2026\\DbTool\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jerry2026\\DbTool\\DbToolServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
